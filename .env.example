# ============================================================================
# Copier en .env.local et renseigner. AUCUNE valeur réelle dans ce fichier.
# ============================================================================

# --- Supabase (obligatoire) -------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret : serveur uniquement, jamais exposé au client, jamais committé.
SUPABASE_SERVICE_ROLE_KEY=

# --- Application (obligatoire) ----------------------------------------------
# URL publique canonique, utilisée dans les emails et les liens ICS.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Emails transactionnels (optionnel : dégradation silencieuse) -----------
# Sans ces variables, aucun email n'est envoyé et aucune action métier n'échoue.
RESEND_API_KEY=
# Domaine vérifié dans Resend, avec SPF/DKIM/DMARC configurés.
EMAIL_FROM=

# --- Rate-limit distribué (optionnel : Vercel KV ou Upstash Redis) ----------
# Sans ces variables, seul un garde-fou mémoire par instance s'applique.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Observabilité (optionnel) ----------------------------------------------
SENTRY_DSN=

# --- Tâches planifiées (optionnel) ------------------------------------------
# Secret partagé protégeant les routes /api/cron/*.
CRON_SECRET=

# --- Géocodage (optionnel) --------------------------------------------------
# User-Agent conforme à la politique d'usage de Nominatim (contact obligatoire).
NOMINATIM_USER_AGENT=
